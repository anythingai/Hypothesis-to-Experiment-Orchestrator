{
  "name": "heo-ai-in-action",
  "version": "1.0.0",
  "description": "HEO - Scientific CI/CD Platform for AI in Action Hackathon 2025",
  "keywords": ["gitlab", "google-cloud", "ai", "scientific-research", "cicd", "automation", "hackathon"],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_USERNAME/heo-ai-in-action"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "playwright test",
    "postinstall": "npm run build",
    
    "deploy:gcp": "gcloud builds submit --config cloudbuild.yaml",
    "demo:quick": "node scripts/demo/quick-demo.js",
    "hackathon:test": "npm run lint && npm run test && npm run build",
    "hackathon:deploy": "npm run hackathon:test && npm run deploy:gcp"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@origintrail/dkg.js": "^6.0.16",
    "@solana/web3.js": "^1.95.4",
    "@solana/spl-token": "^0.4.8",
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.2",
    "@types/node": "22.10.1",
    "@types/react": "19.0.1",
    "@types/react-dom": "19.0.1",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "lucide-react": "^0.468.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "ipfs-http-client": "^60.0.1",
    "oxigraph": "^0.4.0-alpha.7",
    "jsonld": "^8.3.2",
    "snarkjs": "^0.7.4",
    "circomlib": "^2.0.5",
    "axios": "^1.7.9",
    "next-themes": "^0.4.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@playwright/test": "^1.49.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.0"
  },
  "private": false,
  "type": "commonjs",
  "main": "dist-scripts/src/index.js",
  "types": "dist-scripts/src/index.d.ts"
}
