# Environment variables for HEO ElizaOS Plugin example
# Copy this file to .env and fill in values

# Environment Mode and Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Authentication (JWT)
JWT_SECRET=<your-32+ character secret>
JWT_EXPIRY=86400

# Google Gemini (Hypothesis Generation)
GEMINI_API_KEY=<your Gemini API key>
GEMINI_MODEL_NAME=gemini-1.5-flash-latest

# Expose Gemini keys to browser
NEXT_PUBLIC_GEMINI_API_KEY=<your Gemini API key>
NEXT_PUBLIC_GEMINI_MODEL_NAME=gemini-1.5-flash-latest

# Knowledge Graph (OxiGraph / OriginTrail DKG)
OXIGRAPH_ENDPOINT_URL=http://localhost:7878
ORIGINTRAIL_NODE_HOSTNAME=http://localhost
ORIGINTRAIL_NODE_PORT=7878
OT_NODE_HOSTNAME=http://127.0.0.1
OT_NODE_PORT=8900

# DKG Service (dkg.js)
BLOCKCHAIN_ID=hardhat1:31337
ENVIRONMENT=development
PUBLIC_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=0xYourPrivateKeyHere

# Cloud-Lab Execution (Strateos/ECL)
ECL_API_URL=https://app.strateos.com/api
ECL_API_KEY=<your ECL API key>

# Solana Blockchain Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./keypair.json
SOLANA_CLUSTER=devnet

# IPFS Storage (Pinata or local node)
IPFS_ENDPOINT=http://localhost:5001/api/v0
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/
IPFS_API_KEY=<your Pinata API key>
IPFS_API_SECRET=<your Pinata API secret>
PINATA_JWT=<your Pinata JWT>
IS_PRODUCTION=false

# zkSNARK Circuit Paths
PROTOCOL_CHECK_CIRCUIT_WASM_PATH=circuits/protocol_check_js/protocol_check.wasm
PROTOCOL_CHECK_CIRCUIT_ZKEY_PATH=circuits/protocol_check_final.zkey
PROTOCOL_CHECK_VERIFICATION_KEY_PATH=circuits/verification_key.json

# Logging and Feature Flags
LOG_LEVEL=info
ENABLE_HYPOTHESIS_GENERATION=true

# Database (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/yourdb

# Optional Performance Tuning
# MAX_CONCURRENT_REQUESTS=50
# CACHE_TTL=3600

# HEO - Hypothesis-to-Experiment Orchestrator
# Copy this file to .env and fill in your actual values

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-pro-preview-05-06

# OriginTrail DKG Configuration
ORIGINTRAIL_NODE_HOSTNAME=localhost
ORIGINTRAIL_NODE_PORT=8900
OT_NODE_HOSTNAME=localhost
OT_NODE_PORT=8900
BLOCKCHAIN_ID=gnosis_testnet
PUBLIC_KEY=your_origintrail_public_key
PRIVATE_KEY=your_origintrail_private_key
ENVIRONMENT=testnet

# IPFS Configuration
IPFS_ENDPOINT=http://localhost:5001/api/v0
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=./keypair.json
SOLANA_CLUSTER=devnet

# Lab Automation (Strateos/ECL)
ECL_API_KEY=your_ecl_api_key_here
ECL_API_URL=https://api.ecl.cloud
STRATEOS_API_KEY=your_strateos_api_key_here

# zkSNARK Circuit Paths
PROTOCOL_CHECK_CIRCUIT_WASM_PATH=circuits/protocol_check_js/protocol_check.wasm
PROTOCOL_CHECK_CIRCUIT_ZKEY_PATH=circuits/protocol_check_final.zkey
PROTOCOL_CHECK_VERIFICATION_KEY_PATH=circuits/verification_key.json

# Development Flags
NODE_ENV=development
IS_PRODUCTION=false
SKIP_DKG=true

# DKG Advanced Settings
DKG_MAX_RETRIES=300
DKG_FREQUENCY=2
DKG_ALLOWANCE_THRESHOLD=1000000000000000000
DKG_API_VERSION=/v1

# OxiGraph Settings
OXIGRAPH_ENDPOINT=http://localhost:7878

# Optional: JWT for authentication
JWT_SECRET=your_jwt_secret_for_development

# HEO - Scientific CI/CD Platform Environment Configuration

# Google Cloud AI
GEMINI_API_KEY=your_gemini_api_key_here

# OriginTrail DKG
ORIGINTRAIL_NODEURL=https://dkg.origintrail.io
ORIGINTRAIL_TOKEN=your_ot_token_here

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PRIVATE_KEY=your_solana_private_key_here

# IPFS
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Application
NODE_ENV=production
PORT=8080
NEXT_TELEMETRY_DISABLED=1

# Google Cloud (for deployment)
GOOGLE_CLOUD_PROJECT=heo-ai-in-action-2025
GOOGLE_CLOUD_REGION=us-central1

# Lab Automation (Optional)
LAB_API_URL=https://api.emeraldcloudlab.com
LAB_API_KEY=your_lab_api_key_here

# Database (OxiGraph - Local storage)
OXIGRAPH_STORE_PATH=./oxigraph

# MongoDB Atlas Configuration (for MongoDB Challenge Track)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/heo_scientific_data?retryWrites=true&w=majority
MONGODB_DATABASE=heo_scientific_data

# MongoDB Atlas Vector Search (for AI-powered dataset discovery)
MONGODB_VECTOR_INDEX_NAME=dataset_vector_index
MONGODB_EMBEDDING_MODEL=text-embedding-ada-002

# Optional: Advanced Features
ENABLE_ZKSNARKS=true
ENABLE_TOKEN_REWARDS=true
ENABLE_LAB_AUTOMATION=false
ENABLE_MONGODB_VECTOR_SEARCH=true